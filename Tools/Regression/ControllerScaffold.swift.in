import AppKit
import Foundation

enum MenuBarEffect { case off, glow, diffuse }
final class Preferences {
    var showNetwork = true
    var showCPU = true
    var showGPU = true
    var showMemory = true
    var menuBarLayout = MenuBarLayout.auto
    var menuBarEffect = MenuBarEffect.off
}
// These test screen/window/button types supply coordinates only; no GUI is instantiated.
final class NSScreen {
    static let shared = NSScreen()
    static var screens: [NSScreen] { [shared] }
    static var main: NSScreen? { shared }
    var auxiliaryTopRightArea: NSRect? = NSRect(x: 948, y: 0, width: 762, height: 24)
}
final class FakeWindow {
    var frame = NSRect(x: 1071, y: 0, width: 122, height: 24)
    var screen: NSScreen? = NSScreen.shared
}
final class NSStatusBarButton {
    enum ImagePosition { case imageOnly }
    let window: FakeWindow? = FakeWindow()
    var effectiveAppearance: NSAppearance { NSAppearance(named: .aqua)! }
    var image: NSImage?
    var imagePosition = ImagePosition.imageOnly
    var toolTip: String?
}
final class FakeStatusItem {
    var button: NSStatusBarButton? = NSStatusBarButton()
}
final class StatusItemController {
    private let statusItem = FakeStatusItem()
    private let preferences = Preferences()
    private let densityOrder: [MenuBarDensity] = [.full, .compact, .minimal]
    private var measuredDensityIndex: Int? = 1
    private var densityWidths: [CGFloat] = [0, 0, 0]
    private var didPrimeDensityWidths = false
    private var primedMetricSet: [Bool] = []
    private var lastRenderedImageWidth: CGFloat?
    private var shapeChangeSnapshotTimestamp: Date?
    private var effectElapsed: Double = 0
    private var recentMinX: [CGFloat] = []
    private let downgradeWindowSamples = 2
    private var lastDensityChangeAt: Date?
    private let densityCooldown: TimeInterval = 2.0
    private let densityUpgradeBuffer: CGFloat = 14
    private func reanchorForPredictedResize(previousImageWidth: CGFloat?, newImageWidth: CGFloat?, button: NSStatusBarButton) {}
    private func syncPanelAnchor() {}
